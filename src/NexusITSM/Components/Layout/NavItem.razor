@inject NavigationManager Nav

<div class="ni @(IsActive ? "act" : "")" @onclick="Navigate">
    @((MarkupString)GetIcon())
    <span class="ni-label">@Label</span>
    @if (BadgeCount > 0)
    {
        <span class="ni-badge">@BadgeCount</span>
    }
    @if (ShowAlert)
    {
        <span class="ni-badge" style="background:rgba(255,77,109,.2);color:var(--acc2)">!</span>
    }
</div>

@code {
    [Parameter] public string Href { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int BadgeCount { get; set; }
    [Parameter] public bool ShowAlert { get; set; }

    private bool IsActive => Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/') == Href.TrimEnd('/');

    private void Navigate() => Nav.NavigateTo(Href);

    private string GetIcon() => Icon switch
    {
