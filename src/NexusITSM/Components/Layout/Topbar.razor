@inject NavigationManager Nav

<div class="topbar">
    <div class="tb-breadcrumb">
        <span id="tb-page-title" class="bc-cur">@GetPageTitle()</span>
    </div>
    <div class="tb-search">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="Cerca ticket, CI, utente…" @bind="SearchQuery" @bind:event="oninput" />
    </div>
    <div class="tb-right">
        <button class="tb-btn" title="Notifiche">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span class="tb-notif-dot"></span>
        </button>
        <button class="tb-btn" @onclick='() => Nav.NavigateTo("settings")' title="Impostazioni">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <button class="btn-new" @onclick="OpenNewTicket">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuovo Ticket
        </button>
    </div>
</div>

@code {
    [Inject] private NexusITSM.Services.ModalState ModalState { get; set; } = default!;

    private string SearchQuery = "";

    private void OpenNewTicket() => ModalState.OpenNewTicket();

    private string GetPageTitle()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return path switch
        {
            "" => "Dashboard",
            "incidents" => "Incidents",
            "problems" => "Problems",
            "changes" => "Changes",
            "catalog" => "Service Catalog",
            "workflow" => "Workflow Builder",
            "escalation" => "Escalation Matrix",
            "sla" => "SLA Engine",
            "email" => "Email Grabber",
            "cmdb" => "CMDB / Assets",
            "reports" => "Reports",
            "integrations" => "Integrazioni Ext.",
            "governance" => "Governance",
            "portal" => "User Portal",
            "settings" => "Settings",
            _ => "NexusITSM"
        };
    }
}
