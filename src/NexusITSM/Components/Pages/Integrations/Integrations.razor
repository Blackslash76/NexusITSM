@page "/integrations"
@inject NexusITSM.Services.DemoDataService Data

@using NexusITSM.Models.Entities
@using NexusITSM.Models.Enums
@using NexusITSM.Components.Shared

<PageTitle>Integrazioni — NexusITSM</PageTitle>

<!-- Header -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:10px">
    <div>
        <div style="font-size:20px;font-weight:700;color:var(--t1)">Integrazioni Esterne</div>
        <div style="font-size:12px;color:var(--t4);margin-top:3px">Gestisci connessioni con sistemi e piattaforme esterne</div>
    </div>
    <button class="btn pri" @onclick="() => ConfigModalOpen = true">+ Aggiungi Integrazione</button>
</div>

<!-- Integration cards grid (2 columns) -->
<div class="fgrid c2" style="margin-bottom:24px">
    @foreach (var intg in IntegrationList)
    {
        <div class="card" style="display:flex;align-items:flex-start;gap:14px">
            <div style="font-size:32px;flex-shrink:0;width:48px;height:48px;border-radius:12px;background:var(--bg3);display:flex;align-items:center;justify-content:center;border:1px solid var(--bdr)">
                @intg.Icon
            </div>
            <div style="flex:1;min-width:0">
                <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px">
                    <div style="font-size:14px;font-weight:700;color:var(--t1)">@intg.Name</div>
                    @if (intg.Status == "Connected")
                    {
                        <span style="font-size:10px;padding:2px 10px;border-radius:20px;background:rgba(48,196,141,.15);color:var(--acc3);font-weight:700;flex-shrink:0">● Connected</span>
                    }
                    else if (intg.Status == "Disconnected")
                    {
                        <span style="font-size:10px;padding:2px 10px;border-radius:20px;background:rgba(255,77,109,.15);color:var(--acc2);font-weight:700;flex-shrink:0">● Disconnected</span>
                    }
                    else
                    {
                        <span style="font-size:10px;padding:2px 10px;border-radius:20px;background:var(--bg3);color:var(--t4);font-weight:700;flex-shrink:0">○ Not Configured</span>
                    }
                </div>
                <div style="font-size:11px;color:var(--t3);margin-bottom:10px;line-height:1.5">@intg.Description</div>
                @if (!string.IsNullOrEmpty(intg.LastSync))
                {
                    <div style="font-size:10px;color:var(--t4);margin-bottom:8px">Ultima sync: <span style="font-family:var(--mono)">@intg.LastSync</span></div>
                }
                <button class="btn sm" @onclick="() => OpenConfig(intg)">⚙ Configura</button>
            </div>
        </div>
    }
</div>

<!-- Integration Log table -->
<div class="card" style="margin-bottom:20px">
    <div class="card-title" style="margin-bottom:14px">Log Integrazione</div>
    <table class="tbl">
        <thead>
            <tr>
                <th>Timestamp</th>
                <th>Integrazione</th>
                <th>Evento</th>
                <th>Status</th>
                <th>Dettagli</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in IntegrationLogs)
            {
                <tr>
                    <td style="font-family:var(--mono);font-size:11px;color:var(--t4);white-space:nowrap">@log.Timestamp</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:6px">
                            <span style="font-size:14px">@log.Icon</span>
                            <span style="font-size:12px;color:var(--t2)">@log.Integration</span>
                        </div>
                    </td>
                    <td style="font-size:12px;color:var(--t1)">@log.Event</td>
                    <td>
                        @if (log.Status == "success")
                        {
                            <span style="font-size:11px;padding:2px 8px;border-radius:20px;background:rgba(48,196,141,.15);color:var(--acc3);font-weight:600">✓ Success</span>
                        }
                        else
                        {
                            <span style="font-size:11px;padding:2px 8px;border-radius:20px;background:rgba(255,77,109,.15);color:var(--acc2);font-weight:600">✗ Error</span>
                        }
                    </td>
                    <td style="font-size:11px;color:var(--t3);max-width:260px">@log.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- API Keys section -->
<div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px">
        <div class="card-title">API Keys</div>
        <button class="btn sm pri" @onclick="GenerateKey">+ Genera nuova chiave</button>
    </div>
    <table class="tbl">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Chiave</th>
                <th>Creata il</th>
                <th>Ultimo utilizzo</th>
                <th>Status</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var key in ApiKeys)
            {
                <tr>
                    <td style="font-size:12px;font-weight:600;color:var(--t1)">@key.Name</td>
                    <td>
                        <span style="font-family:var(--mono);font-size:11px;color:var(--t3);background:var(--bg3);padding:2px 8px;border-radius:4px">@key.MaskedValue</span>
                    </td>
                    <td style="font-family:var(--mono);font-size:11px;color:var(--t4)">@key.Created</td>
                    <td style="font-family:var(--mono);font-size:11px;color:var(--t4)">@key.LastUsed</td>
                    <td>
                        @if (key.Status == "active")
                        {
                            <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:rgba(48,196,141,.15);color:var(--acc3)">Attiva</span>
                        }
                        else
                        {
                            <span style="font-size:10px;padding:2px 8px;border-radius:20px;background:var(--bg3);color:var(--t4)">Revocata</span>
                        }
                    </td>
                    <td>
                        @if (key.Status == "active")
                        {
                            <button class="btn sm" style="color:var(--acc2)" @onclick="() => RevokeKey(key)">Revoca</button>
                        }
                        else
                        {
                            <span style="font-size:11px;color:var(--t4)">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (KeyToast)
    {
        <div style="margin-top:10px;padding:10px 14px;background:rgba(48,196,141,.12);border:1px solid rgba(48,196,141,.3);border-radius:var(--r);font-size:12px;color:var(--acc3)">
            ✓ Nuova API key generata — salvala subito, non sarà più visibile.
        </div>
    }
</div>

<!-- Config Modal -->
<Modal IsOpen="ConfigModalOpen" Title="@($"Configura: {ConfigTarget?.Name ?? "Nuova Integrazione"}")" OnClose="CloseConfigModal" Size="lg">
    <div class="fgrid c2">
        <div class="fg" style="grid-column:1/-1">
            <label class="fl">Endpoint / Host</label>
            <input class="fi" @bind="ConfigHost" placeholder="Es: ldap://dc01.azienda.local" />
        </div>
        <div class="fg">
            <label class="fl">Username / Client ID</label>
            <input class="fi" @bind="ConfigUser" placeholder="service_account" />
        </div>
        <div class="fg">
            <label class="fl">Password / Secret</label>
            <input type="password" class="fi" @bind="ConfigPass" placeholder="••••••••" />
        </div>
        <div class="fg" style="grid-column:1/-1">
            <label class="fl">Note aggiuntive</label>
            <textarea class="fi" @bind="ConfigNotes" style="min-height:60px" placeholder="Configurazioni opzionali, certificati, porte custom…"></textarea>
        </div>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid var(--bdr)">
        <button class="btn" @onclick="CloseConfigModal">Annulla</button>
        <button class="btn" @onclick="TestConnection">🔍 Test connessione</button>
        <button class="btn pri" @onclick="SaveConfig">Salva</button>
    </div>
</Modal>

@code {
    private bool ConfigModalOpen;
    private bool KeyToast;
    private IntegrationCard? ConfigTarget;

    private string ConfigHost = "";
    private string ConfigUser = "";
    private string ConfigPass = "";
    private string ConfigNotes = "";

    private record IntegrationCard(string Icon, string Name, string Description, string Status, string LastSync);

    private static readonly IntegrationCard[] IntegrationList =
    [
        new("🔐", "Active Directory",    "Sincronizzazione utenti e gruppi dal dominio AD aziendale",              "Connected",      "oggi 06:00"),
        new("✉",  "Email Server SMTP",   "Server di posta per invio notifiche e alert automatici",                 "Connected",      "oggi 09:42"),
        new("🛡",  "Wazuh SIEM",          "Integrazione con SIEM per correlazione eventi e alert sicurezza",        "Connected",      "ieri 23:55"),
        new("📡", "Zabbix Monitoring",   "Ricezione alert infrastruttura da Zabbix via webhook",                   "Disconnected",   "3 giorni fa"),
        new("🖥",  "vCenter VMware",      "Inventario automatico VM e host ESXi per CMDB",                         "Not Configured", ""),
        new("💬", "Slack Notifications", "Invio notifiche real-time su canali Slack del team IT",                  "Connected",      "oggi 11:18"),
        new("📋", "Jira",                "Sincronizzazione ticket con progetti Jira per il team Dev",              "Not Configured", ""),
        new("☁",  "Azure AD",            "SSO e provisioning utenti tramite Azure Active Directory / Entra ID",    "Disconnected",   "5 giorni fa"),
    ];

    private record LogEntry(string Timestamp, string Icon, string Integration, string Event, string Status, string Details);

    private static readonly LogEntry[] IntegrationLogs =
    [
        new("2026-04-09 11:18:32", "💬", "Slack",             "Notifica inviata — INC-1001 escalato",        "success", "Canale #it-alerts — 1 utente notificato"),
        new("2026-04-09 09:42:15", "✉",  "Email SMTP",        "Email notifica inviata — SLA Warning",        "success", "Destinatario: marco.rossi@azienda.it"),
        new("2026-04-09 06:00:03", "🔐", "Active Directory",  "Sync utenti completata",                      "success", "42 utenti sincronizzati, 0 errori"),
        new("2026-04-08 23:55:12", "🛡",  "Wazuh SIEM",        "Alert sicurezza ricevuto — brute force AD",   "success", "Correlato a INC-1005 — account lockout HR"),
        new("2026-04-08 14:30:00", "📡", "Zabbix Monitoring", "Connessione persa — timeout 30s",             "error",   "Host zabbix.azienda.local non raggiungibile"),
    ];

    private class ApiKey
    {
        public string Name { get; set; } = "";
        public string MaskedValue { get; set; } = "";
        public string Created { get; set; } = "";
        public string LastUsed { get; set; } = "";
        public string Status { get; set; } = "active";
    }

    private List<ApiKey> ApiKeys =
    [
        new() { Name = "Monitoring Webhook",    MaskedValue = "nxk_••••••••••••••••7f4a", Created = "01/01/2026", LastUsed = "09/04/2026", Status = "active" },
        new() { Name = "Jira Sync Service",     MaskedValue = "nxk_••••••••••••••••3b9c", Created = "15/02/2026", LastUsed = "—",          Status = "revoked" },
        new() { Name = "External Dashboard",    MaskedValue = "nxk_••••••••••••••••a12e", Created = "01/03/2026", LastUsed = "08/04/2026", Status = "active" },
    ];

    private void OpenConfig(IntegrationCard intg)
    {
        ConfigTarget = intg;
        ConfigHost = "";
        ConfigUser = "";
        ConfigPass = "";
        ConfigNotes = "";
        ConfigModalOpen = true;
    }

    private void CloseConfigModal()
    {
        ConfigModalOpen = false;
        ConfigTarget = null;
    }

    private void TestConnection()
    {
        // Placeholder — in produzione invocherebbe un service check
    }

    private void SaveConfig()
    {
        ConfigModalOpen = false;
        ConfigTarget = null;
    }

    private void RevokeKey(ApiKey key) => key.Status = "revoked";

    private async void GenerateKey()
    {
        var newKey = new ApiKey
        {
            Name = "Nuova API Key",
            MaskedValue = $"nxk_••••••••••••••••{Guid.NewGuid().ToString("N")[..4]}",
            Created = DateTime.UtcNow.ToString("dd/MM/yyyy"),
            LastUsed = "—",
            Status = "active"
        };
        ApiKeys.Insert(0, newKey);
        KeyToast = true;
        StateHasChanged();
        await Task.Delay(4000);
        KeyToast = false;
        StateHasChanged();
    }
}
