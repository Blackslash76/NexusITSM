@page "/workflow"
@attribute [Authorize]

<PageTitle>Workflow Builder — NexusITSM</PageTitle>

<div style="display:flex;align-items:center;justify-content:center;height:calc(100vh - 120px);flex-direction:column;gap:16px">
    <div style="width:64px;height:64px;border-radius:16px;background:rgba(75,158,255,.1);border:1px solid rgba(75,158,255,.2);display:flex;align-items:center;justify-content:center;font-size:28px">
        ⚙
    </div>
    <div style="font-size:18px;font-weight:700;color:var(--t1)">Workflow Builder</div>
    <div style="font-size:12px;color:var(--t4);max-width:300px;text-align:center;line-height:1.6">
        Modulo in fase di sviluppo. Sarà disponibile nel prossimo sprint.
    </div>
    <div style="font-size:10px;font-family:var(--mono);color:var(--t4);padding:4px 10px;background:var(--bg3);border-radius:var(--r)">
        Sprint 4 — Coming soon
    </div>
</div>
