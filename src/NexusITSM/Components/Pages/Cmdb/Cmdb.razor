                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- SNMP Devices -->
    <div class="card" style="margin-top:14px">
        <div class="card-title">Dispositivi SNMP</div>
        <table class="tbl">
            <thead>
                <tr>
                    <th>CI</th>
                    <th>Tipo</th>
                    <th>IP</th>
                    <th>Versione SNMP</th>
                    <th>Status</th>
                    <th>Ultimo Poll</th>
                    <th>Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ci in CIsWithSnmp)
                {
                    <tr>
