    // ── Helpers ────────────────────────────────────────────────────────
    private static string FormatRelative(DateTime? dt)
    {
        if (dt == null) return "—";
        var diff = DateTime.UtcNow - dt.Value;
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds}s fa";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m fa";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h fa";
        return $"{(int)diff.TotalDays}g fa";
    }

    private static string CritColor(CICriticality c) => c switch
    {
        CICriticality.Critical => "var(--acc2)",
        CICriticality.High     => "var(--acc6)",
        CICriticality.Medium   => "var(--acc4)",
        _                      => "var(--t4)"
    };

    private static RenderFragment CiStatusBadge(CIStatus s) => s switch
