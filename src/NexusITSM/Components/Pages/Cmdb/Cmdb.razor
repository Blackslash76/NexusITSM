                        <td><span class="tag">@ci.Type</span></td>
                        <td style="font-family:var(--mono);font-size:11px;color:var(--t2)">@(ci.IpAddress ?? "—")</td>
                        <td>
                            <span style="background:rgba(75,158,255,.1);color:var(--acc);padding:2px 8px;border-radius:3px;font-family:var(--mono);font-size:11px">@ci.SnmpVersion</span>
                        </td>
                        <td>@CiStatusBadge(ci.Status)</td>
                        <td style="font-size:11px;color:var(--t4);font-family:var(--mono)">@FormatRelative(ci.LastSeen)</td>
                        <td>
                            <div style="display:flex;gap:5px">
                                <button class="btn sm">📡 Poll</button>
                                <button class="btn sm">⚙ Config</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

