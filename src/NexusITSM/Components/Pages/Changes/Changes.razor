    // ── Actions ───────────────────────────────────────────────────────────────
    private void CloseNewChange()
    {
        ShowNewChange  = false;
        NewTitle       = "";
        NewDescription = "";
        NewRequester   = "";
        NewAssigneeId  = "";
        NewRisk        = 2;
        NewImpact      = 2;
        NewType        = ChangeType.Standard;
        NewCabDate     = null;
    }

    private void CreateChange()
    {
        if (string.IsNullOrWhiteSpace(NewTitle)) return;

        var seq    = Data.Changes.Count + 1;
        var agent  = Data.Agents.FirstOrDefault(a => a.Id == NewAssigneeId);
        var change = new Change
        {
            Id          = $"CHG-{seq:D3}",
            Title       = NewTitle,
            Type        = NewType,
            Status      = ChangeStatus.Draft,
            Risk        = Math.Clamp(NewRisk,   1, 5),
            Impact      = Math.Clamp(NewImpact, 1, 5),
            Requester   = NewRequester,
            Description = NewDescription,
            Assignee    = agent,
            AssigneeId  = agent?.Id,
            CabDate     = NewCabDate,
            CreatedAt   = DateTime.UtcNow,
        };

        Data.Changes.Insert(0, change);
        CloseNewChange();
    }

    private void OpenDetail(Change c)
    {
        DetailChange = c;
        DetailTab    = "dettagli";
        ShowDetail   = true;
    }
